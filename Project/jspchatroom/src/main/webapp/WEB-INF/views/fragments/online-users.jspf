<div id="onlineUserList" aria-live="polite">
    <c:choose>
        <c:when test="${empty onlineUsers}">
            <p class="presence-empty"><fmt:message key="message.noUsers"/></p>
        </c:when>
        <c:otherwise>
            <ul class="presence-list">
                <c:forEach var="u" items="${onlineUsers}">
                    <li>
                        <c:set var="avatarUserId" value="${u.id}"/>
                        <c:set var="avatarName" value="${u.username}"/>
                        <span class="avatar" aria-hidden="true">
                            <%@ include file="avatar-image.jspf" %>
                        </span>
                        <span class="presence-name"><c:out value="${u.username}"/></span>
                        <time><fmt:formatDate value="${u.lastLoginAt}" pattern="HH:mm"/></time>
                    </li>
                </c:forEach>
            </ul>
        </c:otherwise>
    </c:choose>
</div>
