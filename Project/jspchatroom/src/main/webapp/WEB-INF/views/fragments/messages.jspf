<%@ page pageEncoding="UTF-8" %>
<p class="meta" id="emptyMessages" ${empty messages ? '' : 'hidden'}><fmt:message key="message.noMessages"/></p>
<ul class="msg" id="msgList">
<fmt:message key="extension.label4" var="translateLabel"/>
<c:forEach var="m" items="${messages}">
                        <li data-id="${m.id}">
                            <span class="meta">[<fmt:formatDate value="${m.createdAt}" pattern="MM-dd HH:mm"/>]</span>
                            <b><c:out value="${m.username}"/></b>:
                            <%-- c:out 默认转义 HTML，防止消息内容中的标签破坏页面 --%>
                            <c:out value="${m.content}"/>
                            <%-- 翻译入口：点 🌐 选目标语言，译文插到本行下面的 .tr-slot 里 --%>
                            <button type="button" class="tr-btn" data-id="${m.id}"
                                    title="<c:out value='${translateLabel}'/>" aria-label="<c:out value='${translateLabel}'/>">
                                <span class="tr-icon" aria-hidden="true"></span>
                            </button>
                            <div class="tr-slot" data-id="${m.id}"></div>
                        </li>
                    </c:forEach>
</ul>
<p class="meta" id="recentMessageSummary" ${empty messages ? 'hidden' : ''}>
<fmt:message key="message.showingRecent">
                        <fmt:param value="${messages.size()}"/>
                        <fmt:param value="${totalMessages}"/>
                        <fmt:param value="${maxMessageCount}"/>
                    </fmt:message>
</p>
