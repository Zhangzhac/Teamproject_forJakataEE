<%@ page pageEncoding="UTF-8" %>
<p class="empty-messages" id="emptyMessages" ${empty messages ? '' : 'hidden'}><fmt:message key="message.noMessages"/></p>
<ul class="message-list" id="msgList">
    <fmt:message key="extension.label4" var="translateLabel"/>
    <c:forEach var="m" items="${messages}">
        <li class="message-row${m.userId eq currentUser.id ? ' message-own' : ''}" data-id="${m.id}">
            <c:set var="avatarUserId" value="${m.userId}"/>
            <c:set var="avatarName" value="${m.username}"/>
            <span class="avatar message-avatar" aria-hidden="true" data-avatar-version="${avatarVersions[avatarUserId]}">
                <%@ include file="avatar-image.jspf" %>
            </span>
            <div class="message-meta">
                <strong><c:out value="${m.username}"/></strong>
                <time><fmt:formatDate value="${m.createdAt}" pattern="MM-dd HH:mm"/></time>
            </div>
            <div class="message-body">
                <div class="message-bubble"><c:out value="${m.content}"/></div>
                <button type="button" class="tr-btn" data-id="${m.id}"
                        title="<c:out value='${translateLabel}'/>" aria-label="<c:out value='${translateLabel}'/>">
                    <span class="tr-icon" aria-hidden="true"></span>
                </button>
            </div>
            <div class="tr-slot" data-id="${m.id}"></div>
        </li>
    </c:forEach>
</ul>
<p class="meta message-summary" id="recentMessageSummary" ${empty messages ? 'hidden' : ''}>
    <fmt:message key="message.showingRecent">
        <fmt:param value="${messages.size()}"/>
        <fmt:param value="${totalMessages}"/>
        <fmt:param value="${maxMessageCount}"/>
    </fmt:message>
</p>
